# Copy to .env.local. Never put a real key in this file or in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Modal endpoints must use HTTPS in production. Same token is a Modal Secret.
MODAL_WORKER_URL=
MODAL_VOICE_URL=
MODAL_WORKER_TOKEN=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Conservative fixed reservation per live visual check; do not reduce without pricing review.
PRACTICE_CHECK_RESERVATION_USD=0.15
