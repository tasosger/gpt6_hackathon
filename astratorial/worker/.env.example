# Copy to worker/.env locally; this file is ignored. Never use NEXT_PUBLIC_* secrets.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
APP_BASE_URL=https://YOUR_APP_DOMAIN
MODAL_WORKER_TOKEN=
# Conservative ceilings verified 2026-09-10 against modal.com/pricing.
# cpu_second/gpu_second include 4 physical cores, 16 GiB RAM, L4 for GPU stages,
# and amortized trusted orchestration/transfer overhead. These are USD per second.
WORKER_PRICE_CEILINGS_JSON={"input_million":10,"output_million":50,"search_call":0.01,"cpu_second":0.0006,"gpu_second":0.0012,"tts_character":0.001,"voice_input_million":32,"voice_output_million":64,"voice_text_input_million":4,"voice_text_output_million":24}
