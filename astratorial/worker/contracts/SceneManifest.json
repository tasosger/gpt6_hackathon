              "required": [
                "nodeName",
                "objectId"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "stepId",
          "startTime",
          "endTime",
          "clipName"
        ],
        "additionalProperties": false
      }
    },
    "rig": {
      "type": "object",
      "properties": {
        "bodyNode": {
          "type": "string"
