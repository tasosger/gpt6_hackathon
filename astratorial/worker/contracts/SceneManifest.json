    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "stepId": {
            "type": "string"
          },
          "startTime": {
            "type": "number"
          },
          "endTime": {
            "type": "number"
          },
          "clipName": {
            "type": "string"
          },
          "handTargets": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "nodeName": {
