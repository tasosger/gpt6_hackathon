{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "goal": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "coffee",
        "cooking",
        "assembly",
        "home"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": [
        "Beginner",
        "Intermediate",
        "Advanced"
      ]
    },
    "estimatedMinutes": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "objects": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "observed": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "observed",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "steps": {
      "minItems": 1,
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "instruction": {
            "type": "string"
          },
          "narration": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 300
          },
          "objectIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "observable": {
            "type": "boolean"
          },
          "completionCriteria": {
            "type": "string"
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "action": {
            "type": "string",
            "enum": [
              "reach",
              "point",
              "grasp",
              "move",
              "rotate",
              "press",
              "release",
              "pour",
              "insert",
              "open",
              "close",
              "wait"
            ]
          }
        },
        "required": [
          "id",
          "title",
          "instruction",
          "narration",
          "durationSeconds",
          "objectIds",
          "observable",
          "completionCriteria",
          "sourceIds",
          "action"
        ],
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "note"
        ],
        "additionalProperties": false
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "question",
          "reason",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "version",
    "title",
    "goal",
    "description",
    "category",
    "difficulty",
    "estimatedMinutes",
    "objects",
    "steps",
    "sources",
    "questions",
    "constraints"
  ],
  "additionalProperties": false
}
